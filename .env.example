# ============================================================
# AI DevFlow Intelligence Suite — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-secure-random-string

# CORS — Frontend URL (used to allow cross-origin requests)
FRONTEND_URL=http://localhost:5173

# API Settings
API_V1_PREFIX=/api/v1

# AI Configuration
# Set AI_PROVIDER to 'ollama' (local) or 'google-gemini' (cloud)
AI_PROVIDER=google-gemini

# Google Gemini Settings (required if AI_PROVIDER=google-gemini)
# Get a key at: https://aistudio.google.com/app/apikey
# Available models: https://ai.google.dev/gemini-api/docs/models
AI_API_KEY=your-google-ai-studio-api-key-here
AI_MODEL=gemini-3.8-flash

# Local Ollama Settings (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=120.0

# GitHub API Settings
# Personal Access Token (classic or fine-grained) for backend API calls
GITHUB_TOKEN=your-github-token-here


# Role Invitation / Authorization Codes
ADMIN_INVITE_CODE=DEVFLOW-ADMIN-SECURE-KEY
MANAGER_INVITE_CODE=DEVFLOW-PM-SECURE-KEY
