# ============================================================
# AI DevFlow Intelligence Suite — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-secure-random-string

# CORS — Frontend URL (used to allow cross-origin requests)
FRONTEND_URL=http://localhost:5173

# API Settings
API_V1_PREFIX=/api/v1

# GitHub API Settings
# Personal Access Token (classic or fine-grained) for backend API calls
GITHUB_TOKEN=your-github-token-here
